{
  "name": "soccer-league-site",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  },
  "overrides": {
    "rollup": "4.44.0"
  }
}
